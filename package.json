{
  "name": "ahmed-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/core"
  ],
  "scripts": {
    "core": "npm run start -w @ahmed/core",
    "test": "npm run test -w @ahmed/core",
    "typecheck": "npm run typecheck -w @ahmed/contract && npm run typecheck -w @ahmed/core",
    "verify": "npm run test && npm run typecheck",
    "readiness:dev": "npx --yes tsx scripts/readiness-check.ts --mode=dev",
    "readiness:prod": "npx --yes tsx scripts/readiness-check.ts --mode=prod",
    "preflight": "npm run verify && npm run readiness:dev"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
