# Copy to apps/mobile/.env and fill in. Never commit .env.
# After editing, restart Expo (npm run mobile) so the values are re-bundled.

# The Core on your computer, reachable from the phone over the same Wi-Fi.
# Use the computer's LAN IP (run `ipconfig` and take the Wi-Fi IPv4 address), not localhost.
EXPO_PUBLIC_CORE_URL=http://192.168.1.10:8787

# Must equal APP_TOKEN in apps/core/.env. This is the only secret the app holds.
EXPO_PUBLIC_APP_TOKEN=change-me-to-a-long-random-string
