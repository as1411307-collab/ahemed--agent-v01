# Server-only owner identity; every enrolled phone belongs to this owner.\nCORE_OWNER_ID=owner-ahmed-0001\n# Generate a 32+ byte unpredictable one-use code, share out-of-band with the owner.\n# Consumed permanently at first successful enrollment; do not commit real values.\nCORE_PAIRING_CODE=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS\n\nANTHROPIC_API_KEY=\nMODEL_NAME=claude-opus-5-5\n# Bind Core to loopback; expose HTTPS only via a trusted reverse proxy.\nHOST=127.0.0.1\nPORT=8787\nWORKSPACE_ROOT=./workspace\nDB_FILE=./ahmed-core.db\n
# Optional Hermes demo bridge. All three must be set or the bridge is disabled.
# API URL must be HTTPS or loopback HTTP. Do not expose Hermes directly to iPhone.
HERMES_API_URL=
HERMES_API_SERVER_KEY=
# Distinct, 32+ random character token. PROPOSE + POLL ONLY, never account credentials.
HERMES_PROPOSAL_KEY=
