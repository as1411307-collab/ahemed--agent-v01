# Server-only. Never put keys in apps/studio, Unreal, URLs, or git.
APP_TOKEN=replace-with-a-long-random-owner-token
NEXUS_PORT=8788
NEXUS_DB_FILE=./nexus.db
WORKSPACE_ROOT=./workspace
# Optional desired config import, validated and versioned on startup.
# NEXUS_CONFIG_FILE=../../nexus.config.json
# Optional authenticated loopback Hermes sidecar (public API v0.22.2 target).
# HERMES_URL=http://127.0.0.1:8642
# HERMES_API_KEY=
# Paid Runs admission stays BLOCKED until a fail-closed policy/cost broker is implemented.
# TAVILY_API_KEY=
# Require a verified operator price quote, integer microUSD/search; no default invented price.
# TAVILY_SEARCH_QUOTE_MICRO_USD=
# NEXUS_MCP_URL=http://127.0.0.1:9000/mcp
# NEXUS_MCP_TOKEN=
# OLLAMA_URL=http://127.0.0.1:11434
# N8N_URL=http://127.0.0.1:5678
